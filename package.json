{
  "name": "annotaitr",
  "version": "1.3.0",
  "description": "Browser-based image and Markdown annotator for AI-assisted review, with built-in web page capture",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "annotaitr": "./index.js",
    "md-annotator": "./index.js"
  },
  "files": [
    "index.js",
    "server",
    "client/dist",
    "client/markdown/src/utils"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build": "vite build --config vite.markdown.config.js && vite build --config vite.image.config.js",
    "prepack": "npm run build",
    "dev:client": "vite dev --config vite.markdown.config.js",
    "dev:client:image": "vite dev --config vite.image.config.js",
    "lint": "eslint . && stylelint '**/*.css'",
    "lint:js": "eslint .",
    "lint:css": "stylelint '**/*.css'",
    "lint:fix": "eslint . --fix && stylelint '**/*.css' --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test test/e2e"
  },
  "keywords": [
    "image",
    "screenshot",
    "markdown",
    "annotator",
    "visual-review",
    "editor",
    "ai",
    "claude"
  ],
  "license": "MIT",
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "express": "^4.21.0",
    "open": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dompurify": "^3.3.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.2.0",
    "highlight.js": "^11.11.0",
    "jsdom": "^29.0.1",
    "katex": "^0.18.1",
    "mermaid": "^11.12.3",
    "omggif": "^1.0.10",
    "pako": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "plantuml-encoder": "^1.4.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^4.0.18",
    "web-highlighter": "^0.7.4"
  }
}
